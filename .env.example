# Cơ sở dữ liệu (SQLite cho dev; production nên dùng PostgreSQL)
DATABASE_URL="file:./dev.db"
# Domain chính – dùng cho canonical, sitemap, schema, link email
NEXT_PUBLIC_SITE_URL="https://domain.com"
# Chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự ngẫu nhiên)
AUTH_SECRET=""
# Thư mục lưu ảnh upload (mặc định ./uploads)
UPLOAD_DIR=""

# Email thông báo đơn hàng (để trống = chỉ ghi log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LaptopLikeNew <no-reply@domain.com>"
ADMIN_NOTIFY_EMAIL=""

# VNPAY (đăng ký tại sandbox.vnpayment.vn để lấy TMN code & secret)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
